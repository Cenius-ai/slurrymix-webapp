# Slurrymix needs no configuration and holds no secrets.
# These are the only two variables the tool or its scripts look at; both work
# with no .env file present at all (the defaults below are the built-in ones).

# Set to any value to disable ANSI colour, exactly like --no-color.
NO_COLOR=

# Interpreter used by install.sh and demo.sh (default: python3).
PYTHON=python3
